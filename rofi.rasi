/* ────────────────────────────────────────────────────────────
   Omarchy Theme for Rofi
   ──────────────────────────────────────────────────────────── */

* {
    bg-color:      #151515;
    fg-color:      #E1DEDE;
    accent-color:  #aca3a3;
    border-color:  #2B2C2B;
    hover-color:   #bab3b3;
    text-color:    #E1DEDE;
    disabled-color: #c7c5c5;
}

window {
    background-color: @bg-color;
    border:           2px;
    border-color:     @border-color;
    border-radius:    12px;
    width:            50%;
    anchor:           center;
    location:         center;
    x-offset:         0;
    y-offset:         0;
}

mainbox {
    background-color: @bg-color;
    children:         [ inputbar, listview ];
    spacing:          10px;
    padding:          10px;
    border-radius:    10px;
}

inputbar {
    background-color: @bg-color;
    border:           1px;
    border-color:     @border-color;
    border-radius:    6px;
    children:         [ prompt, textbox-prompt-colon, entry, case-indicator ];
    padding:          8px;
}

prompt {
    background-color: @bg-color;
    text-color:       @accent-color;
    padding:          6px;
    font:             "monospace 12";
}

textbox-prompt-colon {
    background-color: @bg-color;
    text-color:       @accent-color;
    padding:          6px;
    expand:           false;
    str:              ":";
}

entry {
    background-color: @bg-color;
    text-color:       @fg-color;
    placeholder-color: @disabled-color;
    placeholder:      "Type to search...";
    padding:          6px;
}

case-indicator {
    background-color: @bg-color;
    text-color:       @accent-color;
    padding:          6px;
}

listview {
    background-color: @bg-color;
    border:           1px;
    border-color:     @border-color;
    border-radius:    6px;
    columns:          1;
    lines:            8;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    padding:          0px;
    spacing:          2px;
    margin:           0px;
}

element {
    background-color: @bg-color;
    text-color:       @fg-color;
    orientation:      horizontal;
    padding:          8px;
    border-radius:    4px;
    margin:           0px 0px 0px 0px;
}

element normal.normal {
    background-color: @bg-color;
    text-color:       @fg-color;
}

element normal.urgent {
    background-color: @bg-color;
    text-color:       #9a8e8e;
}

element normal.active {
    background-color: @bg-color;
    text-color:       @accent-color;
}

element selected.normal {
    background-color: @accent-color;
    text-color:       #edecec;
    border-radius:    4px;
}

element selected.urgent {
    background-color: #9a8e8e;
    text-color:       #edecec;
    border-radius:    4px;
}

element selected.active {
    background-color: @hover-color;
    text-color:       #edecec;
    border-radius:    4px;
}

element alternate.normal {
    background-color: @bg-color;
    text-color:       @fg-color;
}

element alternate.urgent {
    background-color: @bg-color;
    text-color:       #9a8e8e;
}

element alternate.active {
    background-color: @bg-color;
    text-color:       @accent-color;
}

element-icon {
    background-color: transparent;
    size:             24px;
    border:           0px;
    margin:           0px 8px 0px 0px;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        inherit;
    vertical-align:   0.5;
}

message {
    background-color: @bg-color;
    border:           1px;
    border-color:     @border-color;
    border-radius:    6px;
    padding:          8px;
    margin-top:       8px;
}

textbox {
    background-color: @bg-color;
    text-color:       @fg-color;
    border-radius:    4px;
    padding:          4px;
}

error-message {
    background-color: #9a8e8e;
    text-color:       #edecec;
    padding:          8px;
    border-radius:    6px;
    border:           1px solid #9a8e8e;
}
